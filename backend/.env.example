# ---- LLM provider ------------------------------------------------------
# Get a key at https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-key-here
# Optional: any OpenAI-compatible endpoint (e.g. an Azure/OpenRouter proxy)
OPENAI_BASE_URL=https://api.openai.com/v1

# Models
CHAT_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small
TEMPERATURE=0.3

# ---- RAG tuning --------------------------------------------------------
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
TOP_K=5
MAX_HISTORY=10

# ---- Uploads -----------------------------------------------------------
MAX_UPLOAD_MB=25

# ---- Server ------------------------------------------------------------
# Comma-separated list of allowed origins for CORS ("*" for any)
CORS_ORIGINS=http://localhost:5173,http://localhost:4173,http://localhost:8000
LOG_LEVEL=INFO
