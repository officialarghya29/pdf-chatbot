# ---- LLM provider ------------------------------------------------------
# Get a key at https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-key-here
# Optional: any OpenAI-compatible endpoint (e.g. an Azure/OpenRouter proxy)
OPENAI_BASE_URL=https://api.openai.com/v1

# Models
CHAT_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small
TEMPERATURE=0.3

# ---- RAG tuning --------------------------------------------------------
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
TOP_K=5
MAX_HISTORY=10

# ---- Retrieval ---------------------------------------------------------
# Hybrid search blends embedding similarity with a BM25 lexical score so
# exact terms (IDs, names, numbers) are not lost. Set to false for pure
# vector search. HYBRID_ALPHA is the lexical share (0.0-1.0).
HYBRID_SEARCH=true
HYBRID_ALPHA=0.35
# MMR diversification: 1.0 = pure relevance, lower = more diverse passages.
MMR_LAMBDA=0.7

# ---- Uploads -----------------------------------------------------------
MAX_UPLOAD_MB=25

# ---- Server ------------------------------------------------------------
# Comma-separated list of allowed origins for CORS ("*" for any)
CORS_ORIGINS=http://localhost:5173,http://localhost:4173,http://localhost:8000
LOG_LEVEL=INFO
